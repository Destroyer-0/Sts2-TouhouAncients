[gd_resource type="ShaderMaterial" load_steps=2 format=3 uid="uid://dfrtbkarkjxf5"]

[sub_resource type="Shader" id="Shader_AkyuuScroll"]
code = "shader_type canvas_item;

uniform sampler2D screen_src : hint_screen_texture, repeat_disable, filter_linear;

uniform float threshold : hint_range(0,1);
uniform float roll_radius : hint_range(0.01, 0.2) = 0.035; 
uniform float shadow_width : hint_range(0.0, 0.2) = 0.15;  
uniform float waviness : hint_range(0.0, 0.05) = 0.008;    
uniform float wave_count : hint_range(1.0, 30.0) = 4.0;    

uniform vec4 paper_color : source_color = vec4(0.75, 0.70, 0.60, 1.0); 
uniform vec4 pole_color : source_color = vec4(0.25, 0.15, 0.08, 1.0);   

void fragment() {
    float eased_threshold = smoothstep(0.0, 1.0, threshold);
    float wave = sin(UV.y * wave_count * 3.14159) * waviness;
    float edge_x = mix(1.2, -0.2, eased_threshold) + wave;

    float dist = UV.x - edge_x;

    // CanvasGroup 的 backbuffer 是预乘 alpha，采回来先除回去；a 太小的直接丢色，免得炸白。
    vec4 src = textureLod(screen_src, SCREEN_UV, 0.0);
    src.rgb = src.a > 0.02 ? clamp(src.rgb / src.a, 0.0, 1.0) : vec3(0.0);

    float alpha = 0.0;
    vec3 final_color = vec3(0.0);

    // 卷轴左侧 = 原画面，靠近卷轴处压一道阴影；右侧 alpha 保持 0，透出下面的涅奥。
    if (dist < 0.0) {
        alpha = src.a;
        float shadow = 1.0 - smoothstep(-shadow_width, 0.0, dist);
        final_color = src.rgb * mix(0.45, 1.0, shadow);
    }

    // 卷筒：跨过交界的一段圆柱
    if (dist > -roll_radius && dist < 0.0) {
        alpha = 1.0;
        float u = (dist + roll_radius) / roll_radius; 
        float nx = u * 2.0 - 1.0; 
        float nz = sqrt(max(0.0, 1.0 - nx * nx)); 
        vec3 normal = vec3(nx, 0.0, nz);
        
        vec3 light_dir = normalize(vec3(0.7, 0.2, 0.8)); 
        float diff = max(0.0, dot(normal, light_dir));
        diff = mix(0.5, 1.0, diff); 
        
        vec3 view_dir = vec3(0.0, 0.0, 1.0);
        vec3 half_dir = normalize(light_dir + view_dir);
        float spec = pow(max(0.0, dot(normal, half_dir)), 12.0);
        
        final_color = paper_color.rgb * diff + vec3(0.015) * spec;
    }

    float pole_margin = 0.035;
    bool is_pole = (UV.y < pole_margin) || (UV.y > 1.0 - pole_margin);
    
    if (is_pole && dist > -roll_radius * 1.3 && dist < roll_radius * 0.1) {
        alpha = 1.0;
        float p_radius = roll_radius * 1.4;
        float p_u = (dist + roll_radius * 1.3) / p_radius;
        float p_nx = p_u * 2.0 - 1.0;
        float p_nz = sqrt(max(0.0, 1.0 - p_nx * p_nx));
        vec3 p_normal = vec3(p_nx, 0.0, p_nz);
        
        vec3 light_dir = normalize(vec3(0.7, 0.2, 0.8));
        float p_diff = max(0.0, dot(p_normal, light_dir));
        p_diff = mix(0.3, 1.0, p_diff);
        
        final_color = pole_color.rgb * p_diff;
    }

    COLOR = vec4(final_color, alpha * COLOR.a);
}"

[resource]
resource_local_to_scene = true
shader = SubResource("Shader_AkyuuScroll")
shader_parameter/threshold = 0.0
shader_parameter/roll_radius = 0.035
shader_parameter/shadow_width = 0.15
shader_parameter/waviness = 0.008
shader_parameter/wave_count = 4.0
shader_parameter/paper_color = Color(0.75, 0.7, 0.6, 1)
shader_parameter/pole_color = Color(0.25, 0.15, 0.08, 1)
