resource_name = "RandomChange"
script/source = "extends Node
@onready var sprite_a: TextureRect = $\"../Marisa1\"
@onready var sprite_b: TextureRect = $\"../Marisa2\"

func _ready() -> void:
	var show_a: bool = randi() % 2 == 0   # 随机 true/false
	sprite_a.visible = show_a
	sprite_b.visible = not show_a
"

